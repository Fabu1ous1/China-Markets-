# ===== Пример настроек для США =====
# Скопируйте в .env и заполните. Перед запуском прочитайте раздел «США» в README.

BOT_TOKEN=123456789:AAAA-your-token
ADMIN_IDS=123456789

SHOP_NAME=Vape Shop
CURRENCY=$
# Федеральный минимум в США — 21 год (Tobacco 21)
MIN_AGE=21
# Время заказов по восточному времени (EST, UTC-5)
TZ_OFFSET_HOURS=-5

# 1 — все цены скрыты, клиент отправляет заявку, вы присылаете цену
HIDE_PRICES=1

# USPS вейпы не перевозит — только частные службы с подписью взрослого 21+
DELIVERY_METHODS=UPS (подпись 21+),FedEx (подпись 21+),Самовывоз
PAYMENT_METHODS=Оплата по ссылке,Наличные при самовывозе

CONTACTS=Менеджер: @your_manager\nРаботаем ежедневно 10:00–20:00 (EST)

REGION_LABEL=Штат
REGIONS=AL,AK,AZ,AR,CA,CO,CT,DE,DC,FL,GA,HI,ID,IL,IN,IA,KS,KY,LA,ME,MD,MA,MI,MN,MS,MO,MT,NE,NV,NH,NJ,NM,NY,NC,ND,OH,OK,OR,PA,RI,SC,SD,TN,TX,UT,VT,VA,WA,WV,WI,WY
# Штаты, куда не доставляем. Здесь — штаты с запретами на ароматизированные вейпы/доставку
# на момент написания. Законы меняются — проверьте актуальный список перед запуском!
BLOCKED_REGIONS=CA,MA,NJ,NY,RI,UT

DB_PATH=shop.db
